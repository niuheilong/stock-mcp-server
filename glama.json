{
  "$schema": "https://glama.ai/mcp/schemas/server.json",
  "maintainers": [
    "niuheilong"
  ],
  "name": "stock-mcp-server",
  "description": "🐉 青龙 - 实时A股股票数据 MCP 服务器（新浪/腾讯行情，stdio）",
  "version": "4.4.1",
  "author": {
    "name": "niuheilong",
    "url": "https://github.com/niuheilong"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/niuheilong/stock-mcp-server"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "stock",
    "a-share",
    "finance",
    "trading",
    "china-stock",
    "real-time-data"
  ],
  "categories": [
    "Finance",
    "Search",
    "Research & Data"
  ],
  "runtime": "python",
  "transport": "stdio",
  "tools": [
    {
      "name": "get_stock_price",
      "description": "获取单只 A 股股票实时行情"
    },
    {
      "name": "get_stock_batch",
      "description": "批量获取多只 A 股股票实时行情"
    },
    {
      "name": "get_stock_quote_from_qq",
      "description": "从腾讯财经获取实时行情（备用通道）"
    }
  ],
  "installation": {
    "python": {
      "requirements": "requirements.txt",
      "entry": "mcp_server.py"
    }
  }
}
